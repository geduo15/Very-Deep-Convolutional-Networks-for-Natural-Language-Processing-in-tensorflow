    "import numpy as np\n",
    "import tensorflow as tf\n",
    "import csv\n",
    "import os \n",
    "\n",
    "ALPHABET = \"abcdefghijklmnopqrstuvwxyz0123456789-,;.!?:'\\\"/\\\\|_@#$%^&*~`+ =<>()[]{}\"\n",
    "FEATURE_LEN = 1014\n",
    "cdict = {}\n",
    "for i, c in enumerate(ALPHABET):\n",
    "    cdict[c] = i + 2\n",
    "\n",
    "samples = {}\n",
    "with open('./dbpedia_data/test.csv', encoding='utf-8') as f: \n",
    "    reader = csv.DictReader(f,fieldnames=['class'],restkey='fields')\n",
    "    for row in reader:\n",
    "        label = row['class']\n",
    "        if label not in samples:\n",
    "            samples[label] = []\n",
    "        sample = np.ones(FEATURE_LEN)\n",
    "        count = 0\n",
    "        if row['fields'] is not None:\n",
    "            for field in row['fields']:\n",
    "                if field is not None:\n",
    "                    for char in field.lower():\n",
    "                        if char in cdict:\n",
    "                            sample[count] = cdict[char]\n",
    "                            count += 1\n",
    "                        if count >= FEATURE_LEN-1:\n",
    "                            break\n",
    "                if count >= FEATURE_LEN-1:\n",
    "                    break\n",
    "        samples[label].append(sample)\n",
    "\n",
    "    # 'classes' should be a list of unique class labels encountered, in string form\n",
    "    classes_list = list(samples.keys())\n",
    "    class_samples = []\n",
    "    for c_label in classes_list:\n",
    "        class_samples.append(samples[c_label])\n"
   ]
