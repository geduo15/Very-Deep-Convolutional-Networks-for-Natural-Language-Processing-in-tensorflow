    "for c_samples_list in class_samples:\n",
    "    x_list_flat.extend(c_samples_list)\n",
    "x = np.array(x_list_flat)\n",
    "\n",
    "if x.shape[0] != y.shape[0]:\n",
    "    print(f\"Warning: Mismatch in number of x samples ({x.shape[0]}) and y labels ({y.shape[0]}). This may indicate an issue in data processing.\")\n",
    "    min_len = min(x.shape[0], y.shape[0])\n",
    "    x = x[:min_len]\n",
    "    y = y[:min_len]\n",
    "    y_ = y_[:min_len]\n",
    "    print(f\"Adjusted to {min_len} samples.\")\n",
    "\n",
    "print(f\"Shape of x: {x.shape}\")\n",
    "print(f\"Shape of y (one-hot): {y.shape}\")\n",
    "print(f\"Shape of y_ (integer labels): {y_.shape}\")"
