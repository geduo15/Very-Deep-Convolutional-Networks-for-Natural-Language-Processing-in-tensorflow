    "def build_onehot(input_idx, num_classes_local):\n",
    "    target = np.zeros(num_classes_local)\n",
    "    target[input_idx] = 1\n",
    "    return target\n",
    "\n",
    "num_classes_for_onehot = len(classes_list) \n",
    "print(f\"Number of classes found in test data: {num_classes_for_onehot}\")\n",
    "\n",
    "y_one_hot_list = [] \n",
    "y_integer_list = [] \n",
    "class_name_to_idx_map_test = {name: i for i, name in enumerate(classes_list)}\n",
    "\n",
    "for class_name_str in classes_list:\n",
    "    class_idx = class_name_to_idx_map_test[class_name_str]\n",
    "    for _ in range(len(samples[class_name_str])):\n",
    "        target = build_onehot(class_idx, num_classes_for_onehot) \n",
    "        y_one_hot_list.append(target)\n",
    "        y_integer_list.append(class_idx) \n",
    "\n",
    "y = np.array(y_one_hot_list)\n",
    "y_ = np.array(y_integer_list)"
   ]
  },
