    "import os\n",
    "import time\n",
    "import datetime \n",
    "\n",
    "def batch_iter(x_data, y_data_iter, batch_size_iter, num_epochs_iter, shuffle=False):\n",
    "    \"\"\"\n",
    "    Generates a batch iterator for a dataset.\n",
    "    \"\"\"\n",
    "    data_size = len(x_data)\n",
    "    if data_size == 0:\n",
    "        print(\"Warning: batch_iter received empty x_data.\")\n",
    "        return\n",
    "        \n",
    "    num_batches_per_epoch = int(data_size/batch_size_iter) + (1 if data_size % batch_size_iter != 0 else 0)\n",
    "    if epoch_num == 0: # Print only for the first epoch if num_epochs_iter > 1\n",
    "        print(\"num batches per epoch is: \" + str(num_batches_per_epoch))\n",
    "    \n",
    "    for epoch_num in range(num_epochs_iter):\n",
    "        if shuffle:\n",
    "            shuffle_indices = np.random.permutation(np.arange(data_size))\n",
    "            x_shuffled = x_data[shuffle_indices]\n",
    "            y_shuffled = y_data_iter[shuffle_indices] if y_data_iter is not None else None\n",
    "        else:\n",
    "            x_shuffled = x_data\n",
    "            y_shuffled = y_data_iter\n",
    "        \n",
    "        for batch_idx in range(num_batches_per_epoch):\n",
    "            start_index = batch_idx * batch_size_iter\n",
    "            end_index = min((batch_idx + 1) * batch_size_iter, data_size)\n",
    "            if start_index >= end_index:\n",
    "                continue\n",
    "            x_batch_out = x_shuffled[start_index:end_index]\n",
    "            if y_shuffled is not None:\n",
    "                y_batch_out = y_shuffled[start_index:end_index]\n",
    "                yield list(zip(x_batch_out, y_batch_out)) \n",
    "            else:\n",
    "                yield x_batch_out "
   ]
