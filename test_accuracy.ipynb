    "num_classes_eval_val = y.shape[1] if y is not None and len(y.shape) > 1 and y.shape[1] > 0 else (np.max(y_) + 1 if y_ is not None and len(y_) > 0 else 14) # Fallback to 14 if y/y_ are empty\n",
    "sequence_max_length_eval_val = x.shape[1] if x is not None and len(x.shape) > 1 else FEATURE_LEN\n",
    "num_quantized_chars_eval_val = len(ALPHABET) + 2 \n",
    "embedding_size_eval_val = 16  \n",
    "l2_lambda_eval_val = 0.001    \n",
    "dropout_rate_model_eval = 0.0  \n",
    "\n",
    "cnn_eval_model = CharCNN(num_classes=num_classes_eval_val,\n",
    "                   sequence_max_length=sequence_max_length_eval_val,\n",
    "                   num_quantized_chars=num_quantized_chars_eval_val,\n",
    "                   embedding_size=embedding_size_eval_val,\n",
    "                   l2_reg_lambda=l2_lambda_eval_val,\n",
    "                   dropout_rate=dropout_rate_model_eval)\n",
    "\n",
    "if checkpoint_file_eval and os.path.exists(os.path.dirname(checkpoint_file_eval)):\n",
    "    dummy_input_shape_eval = (1, sequence_max_length_eval_val) \n",
    "    dummy_input_eval = np.zeros(dummy_input_shape_eval, dtype=np.int32)\n",
    "    _ = cnn_eval_model(tf.constant(dummy_input_eval)) \n",
    "    \n",
    "    checkpoint_loader = tf.train.Checkpoint(model=cnn_eval_model)\n",
    "    status_restore = checkpoint_loader.restore(checkpoint_file_eval)\n",
    "    status_restore.expect_partial() # Use expect_partial to avoid errors if optimizer state is not used/matched.\n",
    "    print(f\"Model restored from {checkpoint_file_eval}\")\n",
    "    \n",
    "    # Proceed with batching and prediction only if x is not empty\n",
    "    if x.shape[0] > 0:\n",
    "        eval_batches = batch_iter(x, y_, 128, 1, shuffle=False) \n",
    "        all_preds_list = []\n",
    "        print(\"Starting prediction loop...\")\n",
    "        for data_batch_eval in eval_batches:\n",
    "            if y_ is not None: \n",
    "                x_batch_data_eval, _ = zip(*data_batch_eval)\n",
    "            else: \n",
    "                x_batch_data_eval = data_batch_eval\n",
    "            \n",
    "            if not x_batch_data_eval: \n",
    "                continue\n",
    "            \n",
    "            x_batch_tensor = tf.constant(np.array(x_batch_data_eval), dtype=tf.int32)\n",
    "            logits_eval = cnn_eval_model(x_batch_tensor, training=False) \n",
    "            batch_preds_eval = tf.argmax(logits_eval, axis=1).numpy()\n",
    "            all_preds_list.extend(batch_preds_eval) \n",
    "        all_predictions_np = np.array(all_preds_list)\n",
    "        if y_ is not None and len(all_predictions_np) == len(y_):\n",
    "            correct_preds_sum = float(sum(np.equal(all_predictions_np, y_)))\n",
    "            print(\"Total number of test examples: {}\".format(len(y_)))\n",
    "            print(\"Accuracy: {:g}\".format(correct_preds_sum/float(len(y_))))\n",
    "        else:\n",
    "            print(\"Could not calculate accuracy. Predictions count or ground truth mismatch.\")\n",
    "            print(f\"Number of predictions: {len(all_predictions_np)}, Number of true labels: {len(y_) if y_ is not None else 'None'}\")\n",
    "    else:\n",
    "        print(\"Skipping evaluation as no test data (x) is available.\")\n",
    "else:\n",
    "    print(\"Error: Checkpoint file not found or checkpoint_dir not set. Cannot restore model for evaluation.\")\n"
   ]
