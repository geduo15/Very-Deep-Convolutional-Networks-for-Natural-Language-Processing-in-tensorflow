    "from datasets import load_dataset\n",
    "import os\n",
    "import csv\n",
    "import numpy as np\n",
    "\n",
    "print(\"Starting data setup: Defining constants, downloading, saving, and loading DBPedia train data...\")\n",
    "\n",
    "# Define constants\n",
    "ALPHABET = \"abcdefghijklmnopqrstuvwxyz0123456789-,;.!?:'\\\"/\\\\|_@#$%^&*~`+ =<>()[]{}\"\n",
    "FEATURE_LEN = 1014\n",
    "cdict = {}\n",
    "for i, c in enumerate(ALPHABET):\n",
    "    cdict[c] = i + 2\n",
    "print(\"Constants ALPHABET, FEATURE_LEN, cdict defined.\")\n",
    "\n",
    "# --- Download and Save DBPedia train data ---\n",
    "data_dir = \"./dbpedia_data\"\n",
    "os.makedirs(data_dir, exist_ok=True) \n",
    "print(f\"Ensured directory exists: {data_dir}\")\n",
    "\n",
    "train_csv_path = os.path.join(data_dir, \"train.csv\")\n",
    "\n",
    "print(\"Downloading DBPedia dataset from Hugging Face (this may take a moment)...\")\n",
    "ds = load_dataset(\"DeveloperOats/DBPedia_Classes\", trust_remote_code=True) \n",
    "print(\"Dataset downloaded.\")\n",
    "\n",
    "print(f\"Saving 'train' split to {train_csv_path}...\")\n",
    "with open(train_csv_path, 'w', newline='', encoding='utf-8') as f:\n",
    "    writer = csv.writer(f)\n",
    "    writer.writerow(['class', 'title', 'content']) # Header row\n",
    "    for item in ds['train']:\n",
    "        writer.writerow([str(item['label']), item['title'], item['content']])\n",
    "print(f\"Train data saved to {train_csv_path}\")\n",
    "\n",
    "with open(train_csv_path, 'r', newline='', encoding='utf-8') as f_verify:\n",
    "    reader_verify = csv.reader(f_verify)\n",
    "    print(f\"First 3 lines of {train_csv_path} (including header):\")\n",
    "    for i_verify, row_content_verify in enumerate(reader_verify):\n",
    "        print(row_content_verify)\n",
    "        if i_verify >= 2:\n",
    "            break\n",
    "print(\"--- Finished saving and verifying CSV ---\")\n",
    "\n",
    "print(f\"Loading data from {train_csv_path} into 'samples' dictionary...\")\n",
    "samples = {}\n",
    "with open(train_csv_path, 'r', newline='', encoding='utf-8') as f_read:\n",
    "    reader = csv.DictReader(f_read) \n",
    "    for row_idx, row in enumerate(reader):\n",
    "        label = row['class'] \n",
    "        if label not in samples:\n",
    "            samples[label] = []\n",
    "        \n",
    "        sample_features = np.ones(FEATURE_LEN, dtype=np.int32) \n",
    "        char_count = 0\n",
    "        \n",
    "        text_fields_to_process = []\n",
    "        title = row.get('title', \"\") \n",
    "        content = row.get('content', \"\") \n",
    "        \n",
    "        if title:\n",
    "            text_fields_to_process.append(title)\n",
    "        if content:\n",
    "             text_fields_to_process.append(content)\n",
    "\n",
    "        for field_text in text_fields_to_process:\n",
    "            if char_count >= FEATURE_LEN: \n",
    "                break\n",
    "            for char_val in field_text.lower():\n",
    "                if char_val in cdict:\n",
    "                    if char_count < FEATURE_LEN: \n",
    "                        sample_features[char_count] = cdict[char_val]\n",
    "                        char_count += 1\n",
    "                if char_count >= FEATURE_LEN:\n",
    "                    break\n",
    "        samples[label].append(sample_features)\n",
    "\n",
    "classes = list(samples.keys()) \n",
    "class_samples = [] \n",
    "for c_key in classes:\n",
    "    class_samples.append(samples[c_key])\n",
    "\n",
    "print(f\"Data loaded into 'samples'. Number of classes: {len(classes)}\")\n",
    "if classes: \n",
    "    first_class_key = classes[0]\n",
    "    if samples[first_class_key]: \n",
    "        print(f\"Number of samples for first class ('{first_class_key}'): {len(samples[first_class_key])}\")\n",
    "        if samples[first_class_key][0] is not None: \n",
    "             print(f\"First sample vector for class '{first_class_key}' (first 20 features): {samples[first_class_key][0][:20]}...\")\n",
    "print(\"--- Data loading and initial processing complete ---\")"
   ]
