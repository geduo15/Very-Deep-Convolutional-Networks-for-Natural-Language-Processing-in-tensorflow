    "np.random.seed(10)\n",
    "if len(x) == 0:\n",
    "    print(\"Error: No data loaded into x. Cannot proceed with shuffling and splitting.\")\n",
    "    x_train, x_dev, y_train, y_dev = np.array([]), np.array([]), np.array([]), np.array([])\n",
    "else:\n",
    "    shuffle_indices = np.random.permutation(np.arange(len(y)))\n",
    "    x_shuffled = x[shuffle_indices]\n",
    "    y_shuffled = y[shuffle_indices]\n",
    "    n_dev_samples = min(10000, len(y) // 10) \n",
    "    if n_dev_samples == 0 and len(y) > 0: \n",
    "        n_dev_samples = 1\n",
    "    \n",
    "    if len(y) > n_dev_samples and n_dev_samples > 0:\n",
    "        x_train, x_dev = x_shuffled[:-n_dev_samples], x_shuffled[-n_dev_samples:]\n",
    "        y_train, y_dev = y_shuffled[:-n_dev_samples], y_shuffled[-n_dev_samples:]\n",
    "    else: \n",
    "        x_train, y_train = x_shuffled, y_shuffled\n",
    "        # Ensure x_dev and y_dev are initialized as empty arrays with correct second dimension for consistency\n",
    "        # Use num_classes_actual (derived from loaded data) or a fallback like 14 if num_classes_actual isn't available/valid\n",
    "        fallback_num_classes = 14 if 'num_classes_actual' not in globals() or num_classes_actual == 0 else num_classes_actual\n",
    "        x_dev, y_dev = np.array([]).reshape(0, FEATURE_LEN), np.array([]).reshape(0, fallback_num_classes) \n",
    "    print(\"Train/Dev split: {:d}/{:d}\".format(len(y_train), len(y_dev)))"
   ]
